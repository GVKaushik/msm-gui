<h1>
  List of all movies
</h1>

<hr>
<form action="/insert_movie" method="post">
<div>
  <label for="title_box"> Title </label>
  <input id="title_box" name="title_entry" type="text">
</div>

<div>
  <label for="year_box"> Year </label>
  <input id="year_box" name="year_entry" type="text">
</div>

<div>
  <label for="duration_box"> Duration </label>
  <input id="duration_box" name="duration_entry" type="text">
</div>

<div>
  <label for="desc_box"> Description </label>
  <textarea id="desc_box" name="description_entry" rows="3"></textarea>
</div>

<div>
  <label for="image_box"> Image </label>
  <input id="image_box" name="image_entry" type="text"  >
</div>

<div>
  <label for="director_id_box"> Director ID </label>
  <input id="director_id_box" name="director_id_entry" type="text"  >
</div>

<button> Create movie </button>

</form>




<hr>

<table border="1">
  <tr>
    <th>
      ID
    </th>

    <th>
      Image
    </th>

    <th>
      Title
    </th>

    <th>
      Year
    </th>

    <th>
      Director
    </th>

    <th>
    </th>
  </tr>

  <% @list_of_movies.order({:year => :desc, :title => :asc}).each do |a_movie| %>
  <tr>
    <td>
      <%= a_movie.id %>
    </td>

    <td>
      <img src="<%= a_movie.image %>" style="width:250px;">
    </td>

    <td>
      <%= a_movie.title %>
    </td>

    <td>
      <%= a_movie.year %>
    </td>

    <td>
      <% matching_directors = Director.where({ :id => a_movie.director_id }) %>
      
      <% the_director = matching_directors.at(0) %>

      <% if the_director %>
        <%= the_director.name %>
      <% else %>
        <em>Uh oh! We weren't able to find a director for this movie.	</em>
      <% end %>
  
    </td>

    <td>
      <a href="/movies/<%= a_movie.id %>">
        Show details
      </a>
    </td>
  </tr>
  <% end %>
</table>
